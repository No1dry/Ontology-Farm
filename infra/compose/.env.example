# Run scripts/dev.ps1 prepare (or scripts/dev.sh prepare) to generate local secrets/certs.
COMPOSE_PROJECT_NAME=lzo-dev
LZO_TEST_PROJECT=lzo-test-bootstrap
LZO_PUBLIC_ORIGIN=https://localhost:8443
LZO_HTTPS_PORT=8443
# Generated random values; never use these placeholders in a running stack.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LZO_OWNER_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LZO_APP_PASSWORD=REPLACE_WITH_GENERATED_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LZO_OIDC_CLIENT_SECRET=REPLACE_WITH_GENERATED_SECRET
LZO_IDENTITY_ADMIN_CLIENT_SECRET=REPLACE_WITH_GENERATED_SECRET
LZO_SESSION_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Separate source credential recovery key. Back up via the controlled secret store.
LZO_SOURCE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
LZO_INVITATION_SMTP_CONFIGURED=false
SOURCE_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
SOURCE_MYSQL_PASSWORD=REPLACE_WITH_GENERATED_SECRET
SOURCE_POSTGRES_PASSWORD_NO_TLS=REPLACE_WITH_GENERATED_SECRET
SOURCE_MYSQL_PASSWORD_NO_TLS=REPLACE_WITH_GENERATED_SECRET
